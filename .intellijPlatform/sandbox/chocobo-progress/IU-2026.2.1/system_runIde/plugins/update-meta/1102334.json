{"id":1102334,"xmlId":"idea.plugin.protoeditor","name":"Protocol Buffers","description":"Provides editor support for <a href=\"https://developers.google.com/protocol-buffers/\">Protocol Buffers</a> files.\n    <br>\n    Features:\n    <ul>\n        <li>Support for <code>proto2</code> and <code>proto3</code> syntax levels.</li>\n        <li>Syntax highlighting.</li>\n        <li>Semantic analysis.</li>\n        <li>References and navigation.</li>\n        <li>Quick documentation.</li>\n        <li>Editor enhancements (completion, brace matching, etc.).</li>\n        <li>Navigating between protobuf files and some other languages (Java, Go, Python).</li>\n    </ul>","organization":"JetBrains s.r.o.","tags":["Programming Language"],"version":"262.8665.173","dependencies":["intellij.spellchecker","com.intellij.modules.lang","intellij.platform.structureView"],"optionalDependencies":["org.jetbrains.plugins.go","intellij.java.backend","intellij.java.psi","intellij.python.psi.impl"],"since":"262.8665","until":"262.*","size":709984,"vendor":"JetBrains","sourceCodeUrl":"https://github.com/JetBrains/intellij-plugins/tree/master/protobuf","mainModuleDependencies":[{"type":"plugin","pluginId":"com.intellij.modules.lang"},{"type":"module","moduleName":"intellij.platform.structureView"},{"type":"module","moduleName":"intellij.spellchecker"}],"content":[{"moduleName":"intellij.protoeditor.go","namespace":null},{"moduleName":"intellij.protoeditor.python","namespace":null},{"moduleName":"intellij.protoeditor.jvm","namespace":null}],"modules":[{"moduleName":"intellij.protoeditor.go","moduleDependencies":[{"type":"plugin","pluginId":"org.jetbrains.plugins.go"}]},{"moduleName":"intellij.protoeditor.python","moduleDependencies":[{"type":"module","moduleName":"intellij.python.psi.impl"}]},{"moduleName":"intellij.protoeditor.jvm","moduleDependencies":[{"type":"module","moduleName":"intellij.java.backend"},{"type":"module","moduleName":"intellij.java.psi"}]}]}